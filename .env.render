# ==========================================
# 5CINE BACKEND - RENDER DEPLOYMENT CONFIG
# ==========================================

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MongoDB Atlas (Remote) - Required for Render
# Lấy connection string từ MongoDB Atlas
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxxx.mongodb.net/5cine_booking

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# IMPORTANT: Thay đổi secret key này thành một chuỗi dài, ngẫu nhiên
# Lệnh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_long_random_jwt_secret_key_min_32_characters

JWT_EXPIRE=7d

# ==========================================
# PAYMENT GATEWAY - VNPAY
# ==========================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paygate/pay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/merchant_information

# ==========================================
# PAYMENT GATEWAY - MOMO
# ==========================================
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_API_URL=https://test-payment.momo.vn/v3

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=5Cine <noreply@5cine.com>

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Production Frontend URL
FRONTEND_URL=https://your-frontend-domain.com

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
