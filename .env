# ==========================================
# 5CINE BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Local MongoDB
# MONGO_URI=mongodb://localhost:27017/5cine_booking

# MongoDB Atlas (Remote)
# Hướng dẫn: 
# 1. Tạo tài khoản tại mongodb.com
# 2. Tạo cluster
# 3. Lấy connection string
MONGO_URI=mongodb+srv://hoannvbo:hoannvbo123@cluster0.mzy5guk.mongodb.net/

# Local MongoDB (Simple & Fast)
# MONGO_URI=mongodb://localhost:27017/5cine_booking

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# Port để chạy server
# Khi deploy lên Render, port sẽ được set tự động
PORT=5000

# Node Environment
NODE_ENV=development

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Thay đổi secret key này thành một chuỗi dài, ngẫu nhiên
# Lệnh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# JWT Expiration
JWT_EXPIRE=7d

# ==========================================
# PAYMENT GATEWAY - VNPAY
# ==========================================
# Hướng dẫn: Đăng ký tài khoản tại vnpay.vn
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paygate/pay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/merchant_information

# ==========================================
# PAYMENT GATEWAY - MOMO
# ==========================================
# Hướng dẫn: Đăng ký tài khoản tại momo.vn
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_API_URL=https://test-payment.momo.vn/v3

# ==========================================
# EMAIL CONFIGURATION (FOR OTP & NOTIFICATIONS)
# ==========================================
# Sử dụng Gmail App Password
# Hướng dẫn: Kích hoạt 2FA trên Gmail, tạo App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=5Cine <noreply@5cine.com>

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Frontend URL để CORS
# Local development
FRONTEND_URL=http://localhost:3000

# Production (thêm khi deploy)
# FRONTEND_URL=https://your-frontend-domain.com

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug

# ==========================================
# RENDER.COM DEPLOYMENT
# ==========================================
# Khi deploy lên Render.com:
# 1. Thêm các biến môi trường trên dashboard Render
# 2. Đảm bảo MONGO_URI trỏ tới MongoDB Atlas
# 3. Đặt NODE_ENV=production
# 4. Cập nhật FRONTEND_URL với domain của frontend
