# Backend Configuration

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/5cine_booking
# hoặc sử dụng MongoDB Atlas:
# MONGO_URI=mongodb+srv://hoannvbo_db:hoannvbo@123@cluster0.6v4wwhy.mongodb.net/5cine_booking

# JWT Secret
JWT_SECRET=your_secret_key_here

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# VNPAY Configuration
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paygate/pay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/merchant_information

# MOMO Configuration
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_API_URL=https://test-payment.momo.vn/v3

# Email Configuration (for OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=5Cine <noreply@5cine.com>

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
